# ./dmenu/.dmenurc

## color - unselected background
DMENU_NB="#FDF6E3"
## color - unselected foreground
DMENU_NF="#93A1A1"

## color - selected background
DMENU_SB="#EEE8D5"
## color - selected foreground
DMENU_SF="#CB4B16"

## font
DMENU_FN="Ac 437 Phoenix BIOS"

## terminal command
TERMINAL_CMD="kitty -e"

## export our variables
DMENU_OPTIONS="-fn $DMENU_FN"

# DMENU_FN="-zevv-peep-medium-*-normal--20-175-*-*-c-*-iso8859-15"
# #DMENU_FN="-*-terminus-medium-r-normal-*-20-*-*-*-*-*-iso10646-*"

DMENU_OPTIONS="-fn $DMENU_FN -nb $DMENU_NB -nf $DMENU_NF -sf $DMENU_SF -sb $DMENU_SB"
export DMENU_FN DMENU_NB DMENU_NF DMENU_SF DMENU_SB DMENU_OPTIONS
