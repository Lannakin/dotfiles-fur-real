// vim: filetype=jsonc
{
  "lua lazyspec plugin multi-line": {
    "prefix": "---@type lazyspec",
    "body": [
      "---@type LazySpec",
      "return {",
      "  { -- ",
      "    -- https://github.com/$1:author/$2:repo",
      "    \"$1:author/$2:repo\",",
      "    opts = {},",
      "    keys = {},",
      "  },",
      "}"
    ],
    "description": "lua lazyspec plugin multi-line"
  },

  "lua table keys": {
    "prefix": "vim.tbl_keys",
    "body": "vim.tbl_keys(${1:table})"
  },

  "lua table map": {
    "prefix": "map",
    "body": ["vim.tbl_map(function()", "  $0", "end, ${1:table})"]
  },

  "lua table values": {
    "prefix": "values",
    "body": "vim.tbl_values(${1:table})"
  },

  "lua keymap multi": {
    "prefix": "local map =",
    "body": [
      "local map = vim.keymap.set",
      "",
      "map({ \"${1:mode}\" }, \"${2:lhs}\", \"${3:rhs}\", { desc = \"${4:description\" })"
    ],
    "description": "lua table keymap"
  }
}
