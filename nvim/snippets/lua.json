{
  "lua multiline comment": {
    "prefix": "luamlc",
    "body": ["--[[", "$1", "--]]"],
    "description": "Insert a multiline comment in lua"
  },
  "lua lazyspec single": {
    "prefix": "lualss",
    "body": ["--[[", "$1", "--]]"],
    "description": "Insert a single LazySpec plugin template in lua"
  },
  "lua table keys": {
    "prefix": "keys",
    "body": "vim.tbl_keys(${1:table})"
  },
  "lua table map": {
    "prefix": "map",
    "body": ["vim.tbl_map(function()", "  $0", "end, ${1:table})"]
  },
  "lua table values": {
    "prefix": "values",
    "body": "vim.tbl_values(${1:table})"
  }
}
