return {
  -- https://github.com/author/repo
  "author/repo",
  dependencies = {}, -- only if needed to be loaded as well
  cmd = "whatevercommand",
  opts = {}, -- needed for Lazu to call setup
}

--[[ ^ SINGLE ENTRY ^ ]]--

--###########################################################################--
--[[ SETTINGS SNIPPETS ]]--

--[[ v OPTIONS: EXTEND v ]]--

  opts = { -- Lazy automatically calls require("module-name").setup(opts)
    -- ...
  },

--[[ ^ OPTIONS: EXTEND ^ ]]--

--===========================================================================--

--[[ v OPTIONS: OVERRIDE v ]]--

  config = function()
    -- ...
  end,

--[[ ^ OPTIONS: OVERRIDE ^ ]]--

