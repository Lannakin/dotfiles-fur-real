--[[ v MULTIPLE ENTRIES v ]]--

-- /plugins/name.lua
-- disabled if below line is active
-- if true then return {} end
return {
  {
    -- https://github.com/author/repo
    "author/repo",
    dependencies = {},
    cmd = "whatevercommand",
    opts = {}, -- needed for Lazu to call setup
    config = function(_, opts)
      require("module-name").setup(opts)
    end
  },
  {
    --
  },
}

--[[ ^ MULTIPLE ENTRIES ^ ]]--

