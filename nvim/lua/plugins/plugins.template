--[[ KEYMAPPING SNIPPETS ]]--

--[[ v LAZYSPEC KEYMAPPING: EXTEND v ]]--


  -- one line
  keys = {
    { "lhs_string", "rhs_string|fun()", mode = { "i", "n", "s", "v", "x" }, desc = "desc_string" },
  },

  -- multi-line
  keys = {
    {
      "lhs_string",
      "rhs_string|fun()",
      mode = { "i", "n", "s", "v", "x" },
      ft= "filetype_string|string[]"
      desc = "desc_string",
      other_valid_opts = "whatever",
    },
  }

--[[ ^ LAZYSPEC KEYMAPPING: EXTEND ^ ]]--

