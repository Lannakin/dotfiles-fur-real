#  sxhkdrc
#
# valid modifier names:
# super, hyper, meta, alt, control, ctrl, shift,
# mode_switch, lock, mod1, mod2, mod3, mod4, mod5, any.
#
# --| SXHKD CTL |--------------------------------------------------------------

# make sxhkd reload its configuration files:
# just kidding, this seems not to work with herbstluftwm running
# or maybe there's a fat delay
ctrl + Escape
    pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# --| AUDIO |------------------------------------------------------------------

XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +1%

XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -1%

XF86AudioPlay
    mpc toggle

XF86AudioPrev
    mpc prev

XF86AudioNext
    mpc next

# --| APPLICATIONS |-----------------------------------------------------------

# screenshot selector
alt + shift + s
    "${XDG_CONFIG_HOME}/herbstluftwm/scripts/screenshot.sh"

# window selector
super + w
    rofi -show windowcd -modi windowcd,window

# terminal emulator
ctrl + t
    kitty

# program launcher; must specify as _L b/c support
Super_L; @Super_L
   "${XDG_CONFIG_HOME}"/rofi/launchers/type-1/launcher.sh

super + a
    "${XDG_CONFIG_HOME}"/rofi/applets/bin/apps.sh"
super + shift + s
   "${XDG_CONFIG_HOME}"/herbstluftwm/scripts/screenshot.sh

# screensaver
# ctrl + shift + r
#     xscreensaver-command -lock

# --| HERBSTLUFTWM |-----------------------------------------------------------

# launch neovim in kitty
F12
    kitty -e nvim

# launch layouts + startup programs
alt + F12
    "${XDG_CONFIG_HOME}/herbstluftwm/scripts/herbstluftwm-after.sh"

