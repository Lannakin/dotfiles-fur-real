  "version": "0.2.0",
  "configurations": [
    {
      "type": "bashdb",
      "request": "launch",
      "name": "Bash-Debug (hardcoded script name)",
      "cwd": "${workspaceFolder}",
      "terminalKind": "integrated",
      "program": "${file}",
      "args": ["--sxhkd"]
    },
    {
      "type": "bashdb",
      "request": "launch",
      "name": "Bash-Debug (type in script name)",
      "cwd": "${workspaceFolder}herbstluftwm/scripts/",
      "terminalKind": "integrated",
      "program": "${command:AskForScriptName}",
      "args": ["--sxhkd"]
    },
  ]
}