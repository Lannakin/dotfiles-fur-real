# Look for 'source'd files relative to the checked script,
# and also look for absolute paths in /mnt/chroot
source=/home/lannakin/LA-repos/dotfiles.herbstluftwm/herbstluftwm/herbstluftwm-env
source=/home/lannakin/.config/herbstluftwm/herbstluftwm-env

# Since 0.9.0, values can be quoted with '' or "" to allow spaces
# source-path="My Documents/scripts"

# Allow opening any 'source'd file, even if not specified as input
external-sources=true

# Turn on warnings for unquoted variables with safe values
enable=quote-safe-variables

# Turn on warnings for unassigned uppercase variables
enable=check-unassigned-uppercase

# test externally sourced directives
# disable=SC1091