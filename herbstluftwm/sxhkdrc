#  sxhkdrc
#
# valid modifier names:
#super, hyper, meta, alt, control, ctrl, shift, mode_switch, lock, mod1, mod2, mod3, mod4, mod5, any.
#
#   SXHKD CTL
#================================================================================

# make sxhkd reload its configuration files:
# just kidding, this seems not to work with herbstluftwm running
super + Escape
    pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# AUDIO
#================================================================================

XF86AudioRaiseVolume
    pactl set-sink-volume @DEFAULT_SINK@ +1%

XF86AudioLowerVolume
    pactl set-sink-volume @DEFAULT_SINK@ -1%

XF86AudioPlay
    mpc toggle

XF86AudioPrev
    mpc prev

XF86AudioNext
    mpc next

#   APPLICATIONS
#================================================================================

# window selector
super + m
    rofi -show windowcd -modi windowcd,window

# terminal emulator
ctrl + t
    kitty

# program launcher; must specify as _L b/c support
Super_L; @Super_L
   "${HOME}/.config/rofi/launchers/type-1/launcher.sh"

super + shift + s
    maim --select --format=png "${HOME}"/Pictures/herbstluftwm_screenshots/screenshot"$(date +%s)".png | xclip -selection clipboard -t image/png

#   HERBSTLUFTWM
#================================================================================

# toggle dual head on focused monitor
alt + shift + o
    "${HOME}/.config/herbstluftwm/scripts/toggledualhead.sh"

# launch neovim in kitty
F12
    kitty -e nvim
