#!/usr/bin/env bash
#
# herbstluftwm setup's temporary environment variables
# usage:
# source "${XDG_CONFIG_HOME}/herbstluftwm/herbstluftwm-env"

# --| source xprofile |--------------------------------------------------------
source "${HOME}/.xprofile"

# --| LOG FILES |--------------------------------------------------------------
HERBSTLUFTWMENVLOG="${HOME}/LOGS/desktop-env/herbstluftwm-env.log"

export CONKYLOG="${HOME}/LOGS/desktop-env/herbstluftwm-conky.log"
export HERBSTLUFTWMLOG="${HOME}/LOGS/desktop-env/herbstluftwm.log"
export KEYBINDMANAGERLOG="${HOME}/LOGS/desktop-env/herbstluftwm-sxhkd.log"
export NOTIFICATIONDAEMONLOG="${HOME}/LOGS/desktop-env/herbstluftwm-dunst.log"
export STATUSBARLOG="${HOME}/LOGS/desktop-env/herbstluftwm-polybar.log"
export XRANDRLOG="${HOME}/LOGS/desktop-env/herbstluftwm-xrandr.log"

# --| GLOBAL VARIABLES |-------------------------------------------------------
export STATUSBARHEIGHT=20

# split to avoid masking return values
SCREENSHOTDATE="$(date +"%Y-%m-%d_%Hh%Mm%Ss")"
# SCREENSHOTDIR="${XDG_PICTURES_DIR}"/herbstluftwm_screenshots/screenshot
# export SCREENSHOTOUTPUT="${SCREENSHOTDIR}""${SCREENSHOTDATE}".png
export SCREENSHOTOUTPUT="${HOME}/pictures/herbstluftwm_screenshots/screenshot_""${SCREENSHOTDATE}.png"

# --| LOGGING VARIABLES |------------------------------------------------------
# warning: lazy AF
LOGFILE="${HERBSTLUFTWMENVLOG}"
SCRIPTNAME="herbstluftwm-env"
# timestamp format
TIMESTAMP="$(date +"%Y-%m-%d %H:%M:%S")"
# LOGLEVEL: decrease index with increasing severity
L3="${TIMESTAMP} ${SCRIPTNAME}|debug:"
# L2="${TIMESTAMP} ${SCRIPTNAME}|info:"
# L1="${TIMESTAMP} ${SCRIPTNAME}|warning:"
# L0="${TIMESTAMP} ${SCRIPTNAME}|error:"

touch "${HERBSTLUFTWMENVLOG}"

{
  # echo "${L3} HOME is $HOME."
  # echo "${L3} XDG_CONFIG_HOME is $XDG_CONFIG_HOME."
  echo "${L3} HERBSTLUFTWMENVLOG is $HERBSTLUFTWMENVLOG."
  echo "${L3} LOGFILE path is $LOGFILE."

  echo "${L3} SCREENSHOTOUTPUT is $SCREENSHOTOUTPUT."
  echo "${L3} HERBSTLUFTWMLOG is $HERBSTLUFTWMLOG."
  echo "${L3} CONKYLOG is $CONKYLOG."
  echo "${L3} HERBSTLUFTWMLOG is $HERBSTLUFTWMLOG."
  echo "${L3} KEYBINDMANAGERLOG is $KEYBINDMANAGERLOG."
  echo "${L3} NOTIFICATIONDAEMONLOG is $NOTIFICATIONDAEMONLOG."
  echo "${L3} STATUSBARLOG is $STATUSBARLOG."
  echo "${L3} XRANDRLOG is $XRANDRLOG."

  echo "${L3} STATUSBARHEIGHT is $STATUSBARHEIGHT."
} >"$LOGFILE"

# --| CREATE LOG FILES |-------------------------------------------------------
touch "${HERBSTLUFTWMLOG}"
touch "${NOTIFICATIONDAEMONLOG}"
touch "${STATUSBARLOG}"
touch "${XRANDRLOG}"
touch "${KEYBINDMANAGERLOG}"
touch "${CONKYLOG}"
